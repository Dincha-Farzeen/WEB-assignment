{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "BookedDatesSchema",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "booking_date": {
          "type": "string",
          "format": "date"
        },
        "photographers": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["booking_date", "photographers"]
    }
  }
  